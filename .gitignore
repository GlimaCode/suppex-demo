
# Excel's lock file for a workbook someone has open.
~$*

# Editor tooling, not part of the site.
.claude/

# Test scratch: throwaway uploads and the last run report.
tests/tmp/

# Generated on demand by lib/ogimage.php and named by a content hash, so a
# committed copy is stale the moment a price moves. The directory makes
# itself.
uploads/og/

# The real config, which holds the database password. config.sample.php is
# the tracked one and must stay full of placeholders; this is never tracked,
# and on the server it lives ABOVE public_html anyway.
suppex-config.php

# Archives made for uploading. They contain the whole tree, including any
# config sitting in it at the time.
*.zip
*.tar
*.tar.gz
*.rar

# Local commercial sheets and product research are not public source code.
/*.xlsx
/*.xls
/*.csv
/*.tsv
/products-to-import/

# Downloaded website snapshots and logo exploration outputs.
/SUPPEX _ فروشگاه تخصصی مکمل_های ورزشی و بدنسازی.html
/SUPPEX _ فروشگاه تخصصی مکمل_های ورزشی و بدنسازی_files/
/برندهای مکمل ورزشی _ SUPPEX.html
/برندهای مکمل ورزشی _ SUPPEX_files/
/SUPPEX-logo-files/
/SUPPEX-logo-final/
/SUPPEX-*.png
/SUPPEX-*.jpg

# Runtime media belongs in the hosting/media backup, not in source control.
# Keep the upload protection and the empty product directory in the repo.
/uploads/**
!/uploads/.htaccess
!/uploads/products/
!/uploads/products/.gitkeep
/suppex-private/
/.codex/
