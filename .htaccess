# ===========================================================================
# SUPPEX — site root
# ===========================================================================

# --- Defence in depth: application code is not a web page ------------------
# lib/ and db/ hold includes, not pages. Nothing should ever request them
# directly, so nothing is allowed to. This matters because if PHP execution
# ever breaks — a bad handler, a failed upgrade — every .php file is served as
# plain text, and lib/db.php would then reveal how the database is reached.
RedirectMatch 404 ^/(lib|db)/
<FilesMatch "\.(sql|json|md|ini|log)$">
  Require all denied
</FilesMatch>
# db/catalog-seed.json is only read from disk by seed.php, never over HTTP.

# --- UTF-8 by default -------------------------------------------------------
AddDefaultCharset UTF-8

# --- Compression ------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
                                application/javascript application/json \
                                image/svg+xml
</IfModule>

# --- Caching ----------------------------------------------------------------
# Long for fingerprinted-by-content assets, short for HTML so a price change is
# visible immediately rather than after a week of stale cache.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 7 days"
  ExpiresByType application/javascript  "access plus 7 days"
  ExpiresByType image/webp              "access plus 30 days"
  ExpiresByType image/jpeg              "access plus 30 days"
  ExpiresByType image/png               "access plus 30 days"
  ExpiresByType image/svg+xml           "access plus 30 days"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

# --- Security headers -------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- Force HTTPS ------------------------------------------------------------
# Commented out until the certificate is installed: enabling it first makes the
# site unreachable rather than merely insecure. Uncomment the day cPanel's
# AutoSSL issues the certificate, then set 'https_only' => true in the config.
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} off
#   RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# --- The wrong address ------------------------------------------------------
# Without this, a mistyped URL gets Apache's own page: English, left-to-right,
# and carrying the server version. The path is absolute because Apache serves
# this file for /any/deep/path too, and a relative one would resolve against
# that imaginary directory.
ErrorDocument 404 /404.html

# --- Never list a directory -------------------------------------------------
Options -Indexes


# --- Pretty paths for the generated files -----------------------------------
# The sitemap is PHP because it is built from the database, but crawlers look
# for /sitemap.xml and robots.txt names it that way.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  RewriteRule ^robots\.txt$  robots.php  [L]
</IfModule>

# --- Product pages ----------------------------------------------------------
# product.html is the static demo page and keeps working for anyone who has the
# old link; product.php is the real one, which renders per-product metadata into
# the head. Redirect rather than rewrite, so search engines consolidate on one
# URL instead of indexing the same product twice.
<IfModule mod_rewrite.c>
  RewriteCond %{QUERY_STRING} (^|&)p=([^&]+)
  RewriteRule ^product\.html$ /product.php?p=%2 [R=301,L]

  # Without this, product.html on its own still answers 200 carrying whichever
  # product happens to be written into the static file — the exact duplicate
  # the rule above exists to remove.
  RewriteRule ^product\.html$ /product.php [R=301,L]
</IfModule>
